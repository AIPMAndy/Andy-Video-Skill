{
  "name": "andy-liquid",
  "version": "0.1.0",
  "private": true,
  "description": "Premium liquid and glass effects for modern web applications",
  "keywords": [
    "liquid",
    "glass",
    "glassmorphism",
    "fluid",
    "animation",
    "react",
    "three.js",
    "ui",
    "components"
  ],
  "author": "Andy",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build --filter='!example'",
    "lint": "turbo run lint --filter='!example'",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "prettier": "^3.2.5",
    "turbo": "^2.0.0",
    "typescript": "^5.4.5"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  }
}
